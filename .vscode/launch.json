{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug doe_engine (delimited_text)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/doe_engine.exe",
            "args": [
                "${workspaceFolder}/build/tests/fixtures/delimited_text_experiment/experiment.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
