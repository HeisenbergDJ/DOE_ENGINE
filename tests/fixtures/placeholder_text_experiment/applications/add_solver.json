{
  "type": "command",
  "executable": "{experiment_dir}/resources/add_solver.exe",
  "working_directory": "{design_point_dir}",
  "arguments": [
    "{design_point_dir}/my.in",
    "{design_point_dir}/result.txt"
  ],
  "timeout_seconds": 0,
  "success_exit_codes": [
    0
  ],
  "inputs": [
    {
      "mode": "tagged_copy",
      "source": "{experiment_dir}/resources/my.in.template",
      "destination": "{design_point_dir}/my.in",
      "tagger": {
        "type": "placeholder_text",
        "tags": [
          {
            "placeholder": "{{X1}}",
            "variable": "x1"
          },
          {
            "placeholder": "{{X2}}",
            "variable": "x2"
          }
        ]
      }
    }
  ],
  "outputs": [
    {
      "port": "result_file",
      "type": "file",
      "path": "{design_point_dir}/result.txt",
      "required": true
    }
  ]
}
